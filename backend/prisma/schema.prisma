// Nutq Yo'li — Prisma schema
// Default: SQLite (zero-config). For PostgreSQL: set provider = "postgresql" and DATABASE_URL,
// then you can convert the string columns below back to proper enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role:         "parent" | "specialist" | "admin"
// ExerciseType: "game"   | "speech"     | "hearing"
// GameKind:     "sound_find" | "direction" | "word_pick" | "repeat"
// ChatAuthor:   "ai" | "user"

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("parent")
  title        String?
  avatarLetter String
  // Foydalanuvchi yuklagan rasm — data URL ("data:image/...") yoki publik URL.
  avatarUrl    String?
  /// Mutaxassislar uchun admin tasdiqlash holati.
  /// Boshqa rollar uchun ahamiyatsiz (har doim `true` deb hisoblanadi).
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  childrenAsParent  Child[]        @relation("ParentChildren")
  notes             Note[]         @relation("SpecialistNotes")
  assignments       Assignment[]   @relation("SpecialistAssignments")
  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("AuthorNotifications")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation("AuthorNotifications", fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Bola — eshitish/nutq rivojlanishi kuzatilayotgan asosiy ob'ekt.
/// `implantDate` — reabilitatsiya boshlangan sana: koxlear implant qo'yilgan kun,
/// eshitish apparati ulangan kun yoki diagnoz qo'yilgan kun. Barcha rivojlanish
/// bosqichlari shu kundan boshlab hisoblanadi.
model Child {
  id           String   @id @default(cuid())
  parentId     String
  parent       User     @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  name         String
  dob          DateTime
  implantDate  DateTime
  stage        String
  stageNumber  Int
  totalStages  Int
  emoji        String   @default("🧒")
  /// Ota-ona yuklagan bola rasmi — data URL ("data:image/...") yoki publik URL.
  /// `null` bo'lsa emoji yoki monogram ko'rsatiladi.
  avatarUrl    String?
  wordCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  milestones        Milestone[]
  completions       ExerciseCompletion[]
  progressPoints    ProgressPoint[]
  diagnostics       DiagnosticsSubmission[]
  notes             Note[]
  assignments       Assignment[]
  chatMessages      ChatMessage[]
  chatConversations ChatConversation[]
  speechChecks      SpeechCheck[]
  gameScores        GameScore[]

  @@index([parentId])
}

model Milestone {
  id        String  @id @default(cuid())
  childId   String
  child     Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  day       Int
  title     String
  done      Boolean @default(false)
  current   Boolean @default(false)

  @@index([childId])
}

model ExerciseCompletion {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  exerciseId  String
  date        String
  completedAt DateTime @default(now())

  @@unique([childId, exerciseId, date])
  @@index([childId, date])
}

/// O'yin elementlari — har bir o'yindagi tanlanadigan element (masalan
/// "Ovozni topish"da "it", "mushuk"). Admin paneldan qo'shish, tahrirlash va
/// o'chirish mumkin. Game runtime bu ro'yxatdan elementlarni o'qib turadi va
/// `GameAsset` orqali yuklangan rasm/ovozlarni ulashadi.
model GameItem {
  id           String   @id @default(cuid())
  game         String   // "sound-find" | "word-pick"
  itemKey      String   // "dog", "cat", "olma", ...
  label        String   // foydalanuvchiga ko'rinadigan nom
  emoji        String   @default("✨")
  /// TTS bilan aytiladigan onomatopoeik so'z (sound-find uchun: "vov vov vov").
  /// word-pick'da odatda bo'sh.
  onomatopoeia String?
  /// TTS pitch (1.0 = normal, <1 past, >1 baland).
  pitch        Float?
  /// TTS rate (1.0 = normal).
  rate         Float?
  /// Web Audio fallback chastotasi (Gz).
  frequency    Float?
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([game, itemKey])
  @@index([game])
}

/// O'yin assetlari — admin har bir o'yin elementiga (masalan "Ovozni topish"
/// dagi har bir hayvon) rasm va ovoz yuklay oladi. `kind` = "image" yoki "sound".
/// O'yin runtime bu jadvaldan o'qiydi; topilmasa public/sounds/animals fayllariga
/// keyin emoji/TTS fallback'iga o'tadi.
model GameAsset {
  id        String   @id @default(cuid())
  game      String   // e.g. "sound-find"
  itemKey   String   // e.g. "dog", "cat", "bird"
  kind      String   // "image" | "sound"
  dataUrl   String   // base64 data URL (image/* yoki audio/*)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([game, itemKey, kind])
  @@index([game])
}

/// Mashqlar katalogi — admin paneldan tahrirlanishi mumkin.
/// Kunlik mashqlar shu jadvaldan tanlanadi (active=true bo'lganlardan).
model Exercise {
  id        String   @id
  title     String
  type      String   // "O'yin" | "Nutq" | "Eshitish"
  minutes   Int      @default(2)
  emoji     String   @default("✨")
  stage     Int      @default(1)
  /// Rehabilitatsiya kuni (1-N) — admin shu mashqni qaysi kunga
  /// biriktirganini belgilaydi. `null` bo'lsa, mashq "har kun uchun"
  /// fond hisoblanadi va eski deterministik tanlov logikasiga tushadi.
  /// Bolaning rehab kuni `floor((bugun - implantDate) / 1 kun) + 1`.
  day       Int?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgressPoint {
  id      String @id @default(cuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  month   String
  value   Int
  order   Int    @default(0)

  @@index([childId])
}

/// Diagnostika savollari katalogi — admin paneldan tahrirlanadi.
/// Bola diagnostika topshirayotganda shu jadvalan `active=true` savollar olinadi.
model DiagnosticsQuestion {
  id        String   @id @default(cuid())
  text      String
  category  String   @default("Umumiy")
  ageGroup  String   @default("0–5 yosh")
  weight    Int      @default(2)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiagnosticsSubmission {
  id              String   @id @default(cuid())
  childId         String
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  answers         String
  score           Int
  maxScore        Int
  pct             Int
  recommendations String
  submittedAt     DateTime @default(now())

  @@index([childId, submittedAt])
}

model Note {
  id           String   @id @default(cuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   User     @relation("SpecialistNotes", fields: [specialistId], references: [id], onDelete: Cascade)
  text         String
  createdAt    DateTime @default(now())

  @@index([childId])
}

model Assignment {
  id             String    @id @default(cuid())
  childId        String
  child          Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  specialistId   String
  specialist     User      @relation("SpecialistAssignments", fields: [specialistId], references: [id], onDelete: Cascade)
  title          String
  done           Boolean   @default(false)
  doneAt         DateTime?
  parentFeedback String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([childId])
}

/// Suhbat (conversation) — ChatGPT'dagi kabi alohida thread. Har bir bolada
/// bir nechta suhbat bo'lishi mumkin; foydalanuvchi yon panelda ularni
/// almashtirib turishi mumkin. Birinchi foydalanuvchi xabaridan avtomatik
/// title yaratiladi.
model ChatConversation {
  id        String        @id @default(cuid())
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  title     String        @default("Yangi suhbat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([childId, updatedAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  childId        String
  child          Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// Yangi xabarlar har doim conversationga biriktiriladi. Eski (migration'gacha)
  /// yozuvlar uchun null bo'lishi mumkin — UI'da "Eski suhbat" deb ko'rinadi.
  conversationId String?
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from           String
  text           String
  createdAt      DateTime          @default(now())

  @@index([childId, createdAt])
  @@index([conversationId, createdAt])
}

model SpeechCheck {
  id                  String   @id @default(cuid())
  childId             String
  child               Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  durationMs          Int
  avgLoudness         Float
  voiceActivityRatio  Float
  note                String?
  createdAt           DateTime @default(now())

  @@index([childId, createdAt])
}

model GameScore {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  game      String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  @@index([childId, createdAt])
}
