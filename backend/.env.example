# Hearek backend environment variables
NODE_ENV=development
PORT=3001

# CORS — frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Database — SQLite by default (zero-config). Swap to PostgreSQL for production:
#   provider in prisma/schema.prisma -> "postgresql"
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hearek?schema=public"
DATABASE_URL="file:./dev.db"

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
